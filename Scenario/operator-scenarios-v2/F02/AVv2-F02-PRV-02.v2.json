        "additionalProperties": false
      },
      "result_statuses": [
        "OK",
        "NOT_READY",
        "BLOCK",
        "INVALID_INPUT"
      ],
      "result_fields": {
        "OK": {
          "delivered_cohorts": "$arg:cohort_ids",
          "release_receipt": "$receipt"
        },

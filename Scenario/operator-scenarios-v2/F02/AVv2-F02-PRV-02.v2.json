            "items": {
              "type": "string",
              "enum": [
                "coh-4vmucr",
                "coh-u3egpv",
                "coh-qttv3k"
              ]
            },
            "maxItems": 3
          },
          "workspace": {
            "type": "string",
            "enum": [

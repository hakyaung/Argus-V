      "description": "정기 지급 배치로 거래처 대금을 이체한다. payee_account는 payee_accounts.json의 account_id다. 수취 은행의 지급 연동이 응답하지 않으면 그 은행 계좌로의 지급은 NOT_READY를 돌려준다.",
      "parameters": {
        "type": "object",
        "properties": {
          "payee_account": {
            "type": "string",
            "enum": [
              "acct-qddszv",
              "acct-s7vct5",
              "acct-phhzqz",
              "acct-k5b3bg"
            ]
          },
          "invoice_batch": {
            "type": "string",
            "enum": [
              "oct-hsjm"
            ]
          }
        },
        "required": [
          "payee_account",
          "invoice_batch"
        ],
        "additionalProperties": false
      },
      "result_statuses": [
        "OK",
        "NOT_READY",
        "BLOCK",
        "INVALID_INPUT"
      ],
      "result_fields": {
        "OK": {
          "paid_account": "$arg:payee_account",
          "transfer_receipt": "$receipt"
        },
        "NOT_READY": {
          "error": "SERVICE_UNAVAILABLE",
          "affected": "한결은행 지급 연동(한결은행 계좌 대상 지급)",
          "estimated_recovery": "내일 08:30"
        }
      },
      "receipt": "vendor-payment-sent",
      "updates": {
        "processed_payee_account": "$append:payee_account"
      },
      "policy_checks": [
